rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHarvest(data) {
      return data.userId == request.auth.uid 
        && data.speciesName is string && data.speciesName.size() <= 500
        && (data.speciesNameZh == null || (data.speciesNameZh is string && data.speciesNameZh.size() <= 500))
        && data.imageUrl is string && data.imageUrl.size() <= 2000000
        && data.caughtAt is timestamp;
    }

    match /harvests/{harvestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isSignedIn() && isValidHarvest(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidHarvest(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
  }
}
