{
  "manifest_version": 3,
  "name": "Bio-Record Marine Tracker",
  "version": "1.0.0",
  "description": "AI-powered fish identification and catch registry.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Bio-Record"
  },
  "permissions": ["camera", "storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
